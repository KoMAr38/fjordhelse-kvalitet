# Rådata regenereres av src/generer_data.py med fast seed.
# 100 MB CSV hører ikke hjemme i et repo når den kan gjenskapes eksakt.
# fasit.json med sha256 ligger derimot inne, slik at gjenskapingen kan sjekkes.
data/raw/*.csv

# DuckDB-basen bygges av dbt
data/*.duckdb
data/*.duckdb.wal

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml

# Power BI
# .pbip-mappa SKAL med i Git - det er hele poenget.
# Cache og lokale innstillinger skal ikke.
**/.pbi/localSettings.json
**/.pbi/cache.abf
*.pbix

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS
.DS_Store
Thumbs.db
