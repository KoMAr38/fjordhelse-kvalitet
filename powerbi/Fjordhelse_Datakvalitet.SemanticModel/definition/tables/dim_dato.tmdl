	partition dim_dato = calculated
		mode: import
		source =
				
				VAR FraDato = DATE ( YEAR ( MIN ( fact_henvisning[henvisning_mottatt] ) ), 1, 1 )
				VAR TilDato = DATE ( YEAR ( MAX ( fact_henvisning[henvisning_mottatt] ) ), 12, 31 )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( FraDato, TilDato ),
				    "aar", YEAR ( [Date] ),
				    "maned_nr", MONTH ( [Date] ),
				    "maned_start", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "maned_etikett", FORMAT ( [Date], "yyyy-MM" ),
				    "sortering", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				    "kvartal", "K" & ROUNDUP ( MONTH ( [Date] ) / 3, 0 )
				)

	annotation PBI_Id = c029c05b9166401390868b74400a8580

