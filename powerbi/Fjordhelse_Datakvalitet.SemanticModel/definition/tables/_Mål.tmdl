table _Mål
	lineageTag: ab85fd39-526d-427e-b58e-6e0813f9a83e

	measure 'Antall henvisninger' = COUNTROWS ( fact_henvisning )
		formatString: 0
		lineageTag: 6d7308c2-2867-4923-83dd-ced3c7cdf00c

	measure 'Antall i nevner' = SUM ( fact_henvisning[teller_i_nevner] )
		formatString: 0
		lineageTag: 0da9b73c-3f02-4246-996c-5e9549e79aeb

	measure 'Fristbrudd rapportert' = SUM ( fact_henvisning[fristbrudd_rapportert] )
		formatString: 0
		lineageTag: 756b1b45-d783-46b6-b507-6534ee4a1f2b

	measure 'Fristbrudd kvalitetssikret' = SUM ( fact_henvisning[fristbrudd_kvalitetssikret] )
		formatString: 0
		lineageTag: 076f6f99-3470-4b47-91fb-438428c1021f

	measure 'Andel fristbrudd rapportert' = DIVIDE ( [Fristbrudd rapportert], [Antall henvisninger] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6f2c622a-6be3-479a-9898-7bbf6b03dba7

	measure 'Andel fristbrudd kvalitetssikret' = DIVIDE ( [Fristbrudd kvalitetssikret], [Antall i nevner] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 6527c3c2-c0aa-40b5-8825-66d36259f875

	measure 'Differanse prosentpoeng' = [Andel fristbrudd rapportert] - [Andel fristbrudd kvalitetssikret]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 45a29230-2f89-4e91-a39b-555842761472

	measure 'Andel manglende sluttdato' = DIVIDE ( SUM ( fact_henvisning[flagg_manglende_slutt] ), [Antall henvisninger] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 41250eee-d7ee-45cb-bae0-cf79978d537d

	measure 'Andel prioritet ikke vurdert' = DIVIDE ( SUM ( fact_henvisning[flagg_prioritet_default] ), [Antall henvisninger] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: e1361684-5f2f-4279-aa40-43d54efa751b

	measure 'Andel avvik' = DIVIDE ( SUM ( fact_datakvalitet[antall_avvik] ), SUM ( fact_datakvalitet[antall_rader] ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: dea3203c-4b90-491e-a57f-39c40c3e21f1

	measure 'Andel fristbrudd rapportert i fjor' = CALCULATE ( [Andel fristbrudd rapportert], SAMEPERIODLASTYEAR ( dim_dato[Date] ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2927be35-9bff-4755-91ec-ed895a3910d2

	measure 'Andel fristbrudd kvalitetssikret i fjor' = CALCULATE ( [Andel fristbrudd kvalitetssikret], SAMEPERIODLASTYEAR ( dim_dato[Date] ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 8b025971-6479-4fd3-bc0b-1c9895c987de

	measure 'Endring rapportert pp' = [Andel fristbrudd rapportert] - [Andel fristbrudd rapportert i fjor]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 9b91c21a-46b3-4068-846d-f7f1f22374ce

	measure 'Endring kvalitetssikret pp' = [Andel fristbrudd kvalitetssikret] - [Andel fristbrudd kvalitetssikret i fjor]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b4e90245-7d3c-41d3-87a1-4df3d0bddaab

	measure 'Ikke reelle fristbrudd' = FORMAT ( [Fristbrudd rapportert] - [Fristbrudd kvalitetssikret], "#,##0" )
		lineageTag: 06cb1e66-6ce3-46bc-a69d-6e23dcaa0921

	measure 'Komplett sluttregistrering' = 1 - [Andel manglende sluttdato]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 53cbe3b2-f091-4dc9-bd8e-88c547d876a0

	measure 'Siste modne maned' = DATE ( 2025, 6, 30 )
		formatString: yyyy-mm-dd
		lineageTag: 2312c82e-68fd-4cca-948a-3a97b7977cf0

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'Andel fristbrudd rapportert siste' = CALCULATE ( [Andel fristbrudd rapportert], dim_dato[maned_start] = DATE ( 2025, 6, 1 ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 54982e33-ea9f-4204-b5c3-2447e3288b8e

	measure 'Andel fristbrudd rapportert siste i fjor' = CALCULATE ( [Andel fristbrudd rapportert], dim_dato[maned_start] = DATE ( 2024, 6, 1 ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: b9de8dbe-8f0b-43ed-b87f-b81a7e9dd089

	measure 'Endring rapportert siste' = [Andel fristbrudd rapportert siste] - [Andel fristbrudd rapportert siste i fjor]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 87ca1cd4-7c89-45c2-a345-7fe0a4fca3ae

	measure 'Andel fristbrudd kvalitetssikret siste' = CALCULATE ( [Andel fristbrudd kvalitetssikret], dim_dato[maned_start] = DATE ( 2025, 6, 1 ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: f1894cde-cfca-465b-88b4-4523e24b8a80

	measure 'Andel fristbrudd kvalitetssikret siste i fjor' = CALCULATE ( [Andel fristbrudd kvalitetssikret], DATESINPERIOD ( dim_dato[Date], EDATE ( [Siste modne maned], -12 ), -1, MONTH ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 86f0574f-9e4b-44ad-8f02-665c92bab53d

	measure 'Endring kvalitetssikret siste' = [Andel fristbrudd kvalitetssikret siste] - [Andel fristbrudd kvalitetssikret siste i fjor]
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 0c8f5da3-51fd-4354-a7fb-f7978a434532

	measure 'Pil rapportert' =
			
			VAR E = [Endring rapportert siste]
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( E ), "",
			    E > 0.001, UNICHAR ( 9650 ),
			    E < -0.001, UNICHAR ( 9660 ),
			    UNICHAR ( 9644 )
			)
		lineageTag: 4aede018-ed6a-4f52-aca5-946a3e110fe0

	measure 'Pil kvalitetssikret' =
			
			VAR E = [Endring kvalitetssikret siste]
			RETURN
			SWITCH (
			    TRUE (),
			    ISBLANK ( E ), "",
			    E > 0.001, UNICHAR ( 9650 ),
			    E < -0.001, UNICHAR ( 9660 ),
			    UNICHAR ( 9644 )
			)
		lineageTag: 8995c0ac-7111-4b32-8eec-f819cc4ba178

	measure 'Farge rapportert' = IF ( [Endring rapportert siste] > 0, "#FF5A5A", "#00D6A0" )
		lineageTag: 4ced6a25-6320-48aa-b9ba-72846fe29949

	measure 'Farge kvalitetssikret' = IF ( [Endring kvalitetssikret siste] > 0, "#FF5A5A", "#00D6A0" )
		lineageTag: 28420c0c-8875-4432-8bb1-0eab6fe22bbf

	measure 'Undertekst rapportert' =
			
			VAR E = [Endring rapportert siste] * 100
			VAR Tegn = IF ( E > 0, "+", "" )
			VAR Tall = SUBSTITUTE ( FORMAT ( E, "0.0" ), ".", "," )
			RETURN
			Tegn & Tall & " pp mot i fjor"
		lineageTag: 5f1efaef-7ed1-4dcb-952c-8be0c5cdb9cd

	measure 'Undertekst kvalitetssikret' =
			
			VAR E = [Endring kvalitetssikret siste] * 100
			VAR Tegn = IF ( E > 0, "+", "" )
			VAR Tall = SUBSTITUTE ( FORMAT ( E, "0.0" ), ".", "," )
			RETURN
			Tegn & Tall & " pp mot i fjor"
		lineageTag: 0de96e9f-8739-4433-8f24-75683bdd0430

	column Column1
