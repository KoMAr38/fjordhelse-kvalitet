model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["MartMappe","fnLesCsv","dim_enhet","dim_periode","dim_diagnose","fact_datakvalitet","fact_henvisning","_Mål"]

ref table dim_enhet
ref table dim_periode
ref table dim_diagnose
ref table fact_datakvalitet
ref table fact_henvisning
ref table _Mål

ref cultureInfo en-US

