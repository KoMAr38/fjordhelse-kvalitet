        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#FFFFFF" } },
            "backColor": { "solid": { "color": "#232C3D" } },
            "fontSize": 10
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#E6EDF7" } },
            "backColorPrimary": { "solid": { "color": "#1D2433" } },
            "fontColorSecondary": { "solid": { "color": "#E6EDF7" } },
            "backColorSecondary": { "solid": { "color": "#1A2130" } },
            "fontSize": 10
          }
        ]
      }
    }
  }
}
