              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Dataene er syntetiske. Det finnes ingen pasienter bak radene. De genereres av src/generer_data.py med fast seed, og feilene er lagt inn med vilje og i kjent omfang. Fasiten ligger i data/raw/fasit.json med sha256 av datafila.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#ffffff"
                    }
